{
  "name": "macalc-mcp",
  "version": "0.4.0",
  "description": "Everyday calculator MCP server — curated core of 15 well-scoped tools (income tax FR/US/UK/CA, mortgage, compound interest, VAT, BMI, TDEE…) with on-demand access to the full 446-calculator macalc catalog. Free, no API key.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "macalc-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "build": "node --check src/index.js && node --check src/core-tools.js",
    "test": "node test/smoke.mjs",
    "prepare": "node --check src/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "calculator",
    "math",
    "finance",
    "tax",
    "health",
    "construction",
    "conversions",
    "education",
    "france",
    "belgium",
    "switzerland",
    "canada"
  ],
  "author": "tresor4k",
  "license": "MIT",
  "homepage": "https://macalculatriceenligne.com/mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tresor4k/macalc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tresor4k/macalc-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  }
}
